# ==============================================================================
# APNA GHAR — Backend Environment Configuration (apps/api/.env.example)
# Copy this file to apps/api/.env for local backend development
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Primary Database (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/apna_ghar
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apna_ghar?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/apna_ghar

# Distributed Cache & Temporary Inventory Locks (Redis)
# If Redis server is not reachable locally, backend gracefully falls back to mock Redis
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# Business Constraints
BED_HOLD_DURATION_SECONDS=480

# CORS Allowed Origin (Frontend Next.js app)
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 Media Storage (Optional)
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=apna-ghar-media-dev
R2_PUBLIC_URL=https://media.dev.apnaghar.com

# Razorpay / Payment Gateway (Optional for simulator/testing)
PAYMENT_KEY_ID=rzp_test_placeholder
PAYMENT_KEY_SECRET=rzp_secret_placeholder
PAYMENT_WEBHOOK_SECRET=rzp_webhook_placeholder
