# ==============================================================================
# APNA GHAR — Frontend Environment Configuration (apps/web/.env.example)
# Copy this file to apps/web/.env.local for local development
# ==============================================================================

# Backend API endpoint URL (ending with /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Brand Details
NEXT_PUBLIC_APP_NAME="Apna Ghar"
NEXT_PUBLIC_APP_TAGLINE="Har Sahar Apna Ghar"

# Frontend Application Origin
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
