{
  "name": "apna-ghar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Apna Ghar — Student Accommodation & Living Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:packages": "npm run build --workspace=packages/shared-types",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:packages && npm run build:api && npm run build:web",
    "test:api": "npm run test --workspace=apps/api",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed/seed.ts"
  },
  "keywords": [
    "student-housing",
    "pg-discovery",
    "nest",
    "nextjs",
    "prisma",
    "postgresql",
    "postgis",
    "redis"
  ],
  "author": "Apna Ghar Engineering",
  "license": "UNLICENSED",
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
