# ========================================================
# APNA GHAR — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# RUNTIME & SERVER
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PRIMARY DATABASE (MongoDB)
# Local: mongodb://127.0.0.1:27017/apna_ghar
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/apna_ghar
MONGODB_URI=mongodb://127.0.0.1:27017/apna_ghar

# DISTRIBUTED CACHE & TEMPORARY LOCKS (Redis)
# Local: redis://127.0.0.1:6379
# Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# AUTHENTICATION & SECURITY
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_random_seed
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_random_seed
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_signing_secret_random_seed_value

# BUSINESS LOGIC & CONSTRAINTS
BED_HOLD_DURATION_SECONDS=480

# CORS & CLIENT COMMUNICATION
CORS_ORIGIN=http://localhost:3000

# CLOUDFLARE R2 / S3-COMPATIBLE MEDIA STORAGE (Future Phases)
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY=placeholder_r2_access_key
R2_SECRET_KEY=placeholder_r2_secret_key
R2_BUCKET=apna-ghar-media
R2_PUBLIC_URL=https://media.apnaghar.com

# PAYMENT GATEWAY (Future Phases)
PAYMENT_KEY_ID=placeholder_payment_key_id
PAYMENT_KEY_SECRET=placeholder_payment_key_secret
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# FRONTEND CLIENT ENVIRONMENT (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Apna Ghar"
NEXT_PUBLIC_APP_TAGLINE="Har Sahar Apna Ghar"
