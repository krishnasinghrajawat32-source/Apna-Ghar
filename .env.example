# ==============================================================================
# APNA GHAR — ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "Har Safar, Apna Ghar"
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL Database (Authoritative Source of Truth)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnaghar_db?schema=public"

# Redis Cache, Locks & Temporary Holds
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL="redis://localhost:6379"

# Authentication & Cryptography
JWT_ACCESS_SECRET="apnaghar_dev_super_secret_access_jwt_key_at_least_32_chars_long_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="apnaghar_dev_super_secret_refresh_jwt_key_at_least_32_chars_long_2026"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_SECRET="apnaghar_cookie_signing_secret_key_change_me"

# Inventory Hold Configuration (in seconds, default: 900s = 15 minutes)
INVENTORY_HOLD_TTL_SECONDS=900

# Payment Gateway (Razorpay / Cashfree)
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
PAYMENT_WEBHOOK_SECRET="YourWebhookSecretSigningKeyHere"

# Object Storage (S3 / Cloudflare R2)
STORAGE_PROVIDER=S3
STORAGE_ENDPOINT=""
STORAGE_REGION=ap-south-1
STORAGE_BUCKET_PUBLIC="apnaghar-public-media"
STORAGE_BUCKET_PRIVATE="apnaghar-private-docs"
STORAGE_ACCESS_KEY="YourStorageAccessKey"
STORAGE_SECRET_KEY="YourStorageSecretKey"

# Maps & Geocoding Provider
MAPBOX_ACCESS_TOKEN="pk.YourMapboxPublicToken"
MAPS_API_KEY="YourServerSideMapsApiKey"

# Communications & Notifications
SENDGRID_API_KEY="SG.YourSendgridKey"
EMAIL_FROM="noreply@apnaghar.com"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Client Application Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN="pk.YourMapboxPublicToken"
